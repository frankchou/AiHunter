generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────────────────────────

model User {
  id                   String       @id @default(cuid())
  name                 String?
  email                String?      @unique
  emailVerified        DateTime?
  image                String?
  onboardingStep       Int          @default(0)
  isSuperUser          Boolean      @default(false)     // bypasses all plan limits
  planTier             String       @default("free")   // free | pro | max
  planExpiresAt        DateTime?                        // null = free forever
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  stripeScheduleId     String?      @unique             // active subscription schedule (for period-end downgrade)
  // LemonSqueezy mirrors of the above. Stripe code left in place but
  // unused for new subscriptions — see app/api/payments/* + /api/stripe/*.
  lsCustomerId         String?      @unique             // LemonSqueezy customer ID
  lsSubscriptionId     String?      @unique             // LemonSqueezy subscription ID
  lsVariantId          String?                          // current variant ID (Pro or Max)
  lsRenewsAt           DateTime?                        // next renewal timestamp from LemonSqueezy
  lsEndsAt             DateTime?                        // when subscription ends (set when cancelled)
  pendingPlanTier      String?                          // null=no change pending; "pro" / "free" if user scheduled a downgrade/cancel
  pendingPlanAt        DateTime?                        // when pendingPlanTier takes effect (current period end)
  usageMonth           String?                          // "2026-05", resets counters when month changes
  analysisUsed         Int          @default(0)
  insightsUsed         Int          @default(0)
  cvTailorsUsed        Int          @default(0)
  adUnlocksUsed        Int          @default(0)         // ad sessions watched this month (cap: 5, resets monthly)
  adTickets            Int          @default(0)         // spendable ticket balance (persistent across months)
  lastViewedIndustry   String?                          // sticky selection in 產業 Top 20 (per-user, cross-device)
  createdAt            DateTime     @default(now())
  accounts        Account[]
  sessions        Session[]
  resumes         Resume[]
  preferences     Preference?
  savedJobs       SavedJob[]
  insights        Insight[]
  resumeTailors   ResumeTailor[]
  coverLetters    CoverLetter[]
  coverLetterTailors CoverLetterTailor[]
  cancellationFeedback CancellationFeedback[]
  resumeChats     ResumeChat[]
  jobScores       JobScore[]
  companyUnlockUsage CompanyUnlockUsage[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  version   Int      @default(1)
  fileName  String?
  fileData  String?  @db.Text  // base64 original file
  fileMime  String?            // MIME type for download
  rawText     String   @db.Text
  parsed      Json
  parsedHash  String?            // md5-ish fingerprint of parsed content
  analysis    Json?              // cached AI analysis result
  isActive    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Preference {
  id           String   @id @default(cuid())
  userId       String   @unique
  locations    String[]
  salaryMin    Int      @default(0)
  salaryMax    Int?
  salaryCcy    String   @default("TWD")
  industries   String[]
  employment   String[]
  remote       String[]
  languages    String[]
  titles       String   @default("")
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id           String     @id @default(cuid())
  externalId   String?    @unique
  title        String
  company      String
  ticker       String?
  country      String
  city         String
  remote       String
  type         String
  salaryMin    Int?
  salaryMax    Int?
  ccy          String     @default("TWD")
  yearsMin     Int?
  yearsMax     Int?
  industry     String
  skills       String[]
  description  String     @db.Text
  source       String
  sourceUrl    String
  sourceHash   String?
  postedAt     DateTime?
  crawledAt    DateTime   @default(now())
  score           Float?
  matchReasons    String[]
  scoreUpdatedAt  DateTime?    // AI score cache timestamp (24h TTL)
  savedBy      SavedJob[]
  insights        Insight[]
  resumeTailors   ResumeTailor[]
  coverLetterTailors CoverLetterTailor[]
  jobScores       JobScore[]

  @@index([country, industry, remote])
  @@index([crawledAt])
  @@index([company])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  stage     String   @default("saved")
  notes     String?
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

model Insight {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  companyTrend  String?  @db.Text
  industryTrend String?  @db.Text
  swot          Json
  risks         Json
  strategy      String   @db.Text
  questions     Json
  refs          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

// B 針對性履歷（Max only）。原為 CVTailor，2026-05 改名以與 B CV 區分。
model ResumeTailor {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  fileName  String?           // English: Company_JobTitle_YYYY-MM-DD_Name_resume.pdf
  isCurrent Boolean  @default(true) // true = latest version for this (user, job)
  summary   Json
  bullets   Json
  diffNote  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  @@index([userId, jobId, isCurrent])
}

// A CV（一般 cover letter，全 plan）
model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  version   Int      @default(1)
  fileName  String?           // System-named: <UserName>_cv.pdf
  content   String   @db.Text // free-form cover letter text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// B 針對性 CV（Max only）
model CoverLetterTailor {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  fileName  String?           // English: Company_JobTitle_YYYY-MM-DD_Name_cv.pdf
  isCurrent Boolean  @default(true)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  @@index([userId, jobId, isCurrent])
}

model IndustryCache {
  industry  String   @id
  data      Json
  updatedAt DateTime @default(now())
}

// Quarterly financials per ticker, cached 24h to avoid hammering Yahoo's
// (unofficial) quoteSummary endpoint on every Industry page load.
model FinancialsCache {
  ticker    String   @id
  data      Json
  updatedAt DateTime @default(now())
}

// AI co-create chat thread — Max-only feature for collaborative resume / CV editing.
// Each thread is scoped to one document context (which doc the user is editing).
// We retain the most recent 30 threads per user; older ones are pruned by app logic.
model ResumeChat {
  id        String              @id @default(cuid())
  userId    String
  title     String              // first user message (truncated to ~40 chars)
  docKind   String              // "resume-a" | "cv-a" | "resume-b" | "cv-b" | "general"
  jobId     String?             // set when docKind ∈ {resume-b, cv-b}
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ResumeChatMessage[]

  @@index([userId, updatedAt])
}

// Single chat message. Assistant messages may carry a proposed doc edit
// (editTarget + before/after) that the user can one-click apply.
model ResumeChatMessage {
  id          String     @id @default(cuid())
  chatId      String
  role        String     // "user" | "assistant"
  content     String     @db.Text
  editTarget  String?    // e.g. "summary", "bullet:0:0", "content"
  editBefore  String?    @db.Text
  editAfter   String?    @db.Text
  applied     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  chat        ResumeChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// Records why a paid user downgraded or cancelled — used to optimize the product.
model CancellationFeedback {
  id            String   @id @default(cuid())
  userId        String
  fromTier      String   // "pro" | "max" — what they were on at submission time
  toTier        String   // "free" (cancel) | "pro" (downgrade from max)
  reasons       String[] // multi-select keys, e.g. ["price","not_using","missing_features"]
  freeText      String?  @db.Text
  effectiveAt   DateTime?  // period-end timestamp when the change takes effect
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Per-user-per-job AI match score for Top 20 company modal.
// Persistent: once scored, stored forever unless user re-uploads resume
// (parsedHash mismatch) or manually re-calculates. Independent from
// `Job.score` which is the JobFeed-context generic score.
model JobScore {
  id         String   @id @default(cuid())
  userId     String
  jobId      String
  parsedHash String   // resume.parsedHash at scoring time — staleness probe
  score      Float    // 0..1
  reasons    String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// Pro plan monthly free-unlock allowance per company. Free uses ad tickets
// (see User.adTickets); Max is unlimited. Pro is the only tier needing this
// counter — first 2 pages/company/month free, beyond that user must wait
// until next month or upgrade to Max.
model CompanyUnlockUsage {
  id            String   @id @default(cuid())
  userId        String
  company       String
  month         String   // "YYYY-MM" (UTC), e.g. "2026-05"
  pagesUnlocked Int      @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, company, month])
  @@index([userId, month])
}

// Twinkle Hub (MOL / DGBAS) salary data cache. Each row holds the entire
// year's worth of rows for one dataset_id (e.g., 41685 製造業 2024), so
// /api/salary can answer industry × occupation queries from one DB read
// without re-calling Twinkle. Gov data refreshes annually → safe TTL is
// long, but we cap at 7 days so we pick up Twinkle-side corrections.
model SalaryCache {
  id         String   @id @default(cuid())
  datasetId  String                   // Twinkle dataset_id, e.g. "41685"
  year       String                   // "2024"
  data       Json                     // [{occupation, employees, monthlyTwd, annualTwdWan}, ...]
  fetchedAt  DateTime @default(now())

  @@unique([datasetId, year])
}

// Phase 2 of /salary — classifies known employers into the 6 buckets
// the user wants to filter by (傳統外商 / Tier-1 外商 / 台商 / 大企業
// / 中小企業 / 新創). Joined to Job.company at query time via
// case-insensitive contains match on companyName.
model CompanyClassification {
  id          String   @id @default(cuid())
  companyName String   @unique     // canonical match key against Job.company
  companyType String                // foreign_tier1 | foreign_traditional | tw_local | large_enterprise | sme | startup
  region      String?               // optional headquarters / primary market
  notes       String?
  createdAt   DateTime @default(now())
}
