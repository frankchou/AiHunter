generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────────────────────────

model User {
  id                   String       @id @default(cuid())
  name                 String?
  email                String?      @unique
  emailVerified        DateTime?
  image                String?
  onboardingStep       Int          @default(0)
  isSuperUser          Boolean      @default(false)     // bypasses all plan limits
  planTier             String       @default("free")   // free | pro | max
  planExpiresAt        DateTime?                        // null = free forever
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  usageMonth           String?                          // "2026-05", resets counters when month changes
  analysisUsed         Int          @default(0)
  insightsUsed         Int          @default(0)
  cvTailorsUsed        Int          @default(0)
  adUnlocksUsed        Int          @default(0)         // ad sessions watched this month (cap: 5, resets monthly)
  adTickets            Int          @default(0)         // spendable ticket balance (persistent across months)
  createdAt            DateTime     @default(now())
  accounts        Account[]
  sessions        Session[]
  resumes         Resume[]
  preferences     Preference?
  savedJobs       SavedJob[]
  insights        Insight[]
  resumeTailors   ResumeTailor[]
  coverLetters    CoverLetter[]
  coverLetterTailors CoverLetterTailor[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  version   Int      @default(1)
  fileName  String?
  fileData  String?  @db.Text  // base64 original file
  fileMime  String?            // MIME type for download
  rawText     String   @db.Text
  parsed      Json
  parsedHash  String?            // md5-ish fingerprint of parsed content
  analysis    Json?              // cached AI analysis result
  isActive    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Preference {
  id           String   @id @default(cuid())
  userId       String   @unique
  locations    String[]
  salaryMin    Int      @default(0)
  salaryMax    Int?
  salaryCcy    String   @default("TWD")
  industries   String[]
  employment   String[]
  remote       String[]
  languages    String[]
  titles       String   @default("")
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id           String     @id @default(cuid())
  externalId   String?    @unique
  title        String
  company      String
  ticker       String?
  country      String
  city         String
  remote       String
  type         String
  salaryMin    Int?
  salaryMax    Int?
  ccy          String     @default("TWD")
  yearsMin     Int?
  yearsMax     Int?
  industry     String
  skills       String[]
  description  String     @db.Text
  source       String
  sourceUrl    String
  sourceHash   String?
  postedAt     DateTime?
  crawledAt    DateTime   @default(now())
  score           Float?
  matchReasons    String[]
  scoreUpdatedAt  DateTime?    // AI score cache timestamp (24h TTL)
  savedBy      SavedJob[]
  insights        Insight[]
  resumeTailors   ResumeTailor[]
  coverLetterTailors CoverLetterTailor[]

  @@index([country, industry, remote])
  @@index([crawledAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  stage     String   @default("saved")
  notes     String?
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

model Insight {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  companyTrend  String?  @db.Text
  industryTrend String?  @db.Text
  swot          Json
  risks         Json
  strategy      String   @db.Text
  questions     Json
  refs          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

// B 針對性履歷（Max only）。原為 CVTailor，2026-05 改名以與 B CV 區分。
model ResumeTailor {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  fileName  String?           // English: Company_JobTitle_YYYY-MM-DD_Name_resume.pdf
  isCurrent Boolean  @default(true) // true = latest version for this (user, job)
  summary   Json
  bullets   Json
  diffNote  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  @@index([userId, jobId, isCurrent])
}

// A CV（一般 cover letter，全 plan）
model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  version   Int      @default(1)
  fileName  String?           // System-named: <UserName>_cv.pdf
  content   String   @db.Text // free-form cover letter text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// B 針對性 CV（Max only）
model CoverLetterTailor {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  fileName  String?           // English: Company_JobTitle_YYYY-MM-DD_Name_cv.pdf
  isCurrent Boolean  @default(true)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  @@index([userId, jobId, isCurrent])
}

model IndustryCache {
  industry  String   @id
  data      Json
  updatedAt DateTime @default(now())
}
