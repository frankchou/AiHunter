# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL (Neon free: https://neon.tech | Vercel Postgres | Supabase)
DATABASE_URL="postgresql://user:password@host/aihunter?sslmode=require"

# ── NextAuth ───────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ── Google OAuth ───────────────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Job Source APIs (optional – mock data used when missing) ───────────────
# Adzuna: https://developer.adzuna.com (free 250k calls/mo)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Remotive: free, no key needed

# 104.com.tw: scraping, no key needed

# LinkedIn OAuth (advanced – user-import only)
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
